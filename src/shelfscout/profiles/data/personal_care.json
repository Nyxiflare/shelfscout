{
  "id": "personal_care",
  "name": "Personal care",
  "version": "0.1",
  "calibration": "Starting weights from the ShelfScout V2 specification. They are an uncalibrated hypothesis, not validated ratings, and must be calibrated with expert review and user research.",
  "weights": {
    "materials_build": 10,
    "durability": 12,
    "ergonomics": 12,
    "safety": 18,
    "customer_experience": 12,
    "reliability": 12,
    "after_sales_service": 7,
    "features_performance": 7,
    "aesthetics": 4,
    "brand_trust": 2,
    "price_value": 4
  },
  "gates": [
    {
      "id": "safety-assessed",
      "dimension": "safety",
      "on_missing": "SAFETY_HOLD",
      "min_score": 40,
      "on_below": "SAFETY_HOLD",
      "why": "A product can't be recommended outright without a safety assessment."
    }
  ],
  "safety_requirements": [],
  "requirements_reviewed": "2026-11 from general regulatory knowledge; confirm current rules for the product and country",
  "spec_rules": {
    "durability": [
      {
        "claim": "warranty.years",
        "kind": "linear",
        "poor": 0.5,
        "good": 5,
        "label": "warranty length",
        "basis": "longer warranties cover more of the product's life"
      },
      {
        "claim": "repair.spare_parts_available",
        "kind": "bool",
        "true": 100,
        "false": 30,
        "label": "spare parts available"
      },
      {
        "claim": "repair.repairability_index",
        "kind": "linear",
        "poor": 2,
        "good": 8,
        "label": "repairability index (0-10)"
      }
    ],
    "after_sales_service": [
      {
        "claim": "warranty.years",
        "kind": "linear",
        "poor": 0.5,
        "good": 3,
        "label": "warranty cover"
      },
      {
        "claim": "service.network_in_country",
        "kind": "bool",
        "true": 90,
        "false": 25,
        "label": "service network in your country"
      },
      {
        "claim": "service.typical_repair_days",
        "kind": "linear",
        "poor": 21,
        "good": 3,
        "label": "typical repair turnaround (days)"
      }
    ],
    "brand_trust": [
      {
        "claim": "brand.years_in_market",
        "kind": "linear",
        "poor": 1,
        "good": 15,
        "label": "years in market"
      },
      {
        "claim": "brand.recalls_last_5_years",
        "kind": "linear",
        "poor": 3,
        "good": 0,
        "label": "recalls in the last 5 years"
      },
      {
        "claim": "brand.publishes_full_specs",
        "kind": "bool",
        "true": 80,
        "false": 30,
        "label": "publishes full specifications"
      }
    ],
    "reliability": [
      {
        "claim": "test.failure_rate_pct",
        "kind": "linear",
        "poor": 20,
        "good": 1,
        "label": "independently measured failure rate (%)"
      }
    ]
  }
}
